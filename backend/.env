# Neon Postgres connection string (use the pooled "-pooler" host)
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-PROJECT-pooler.YOUR-REGION.aws.neon.tech/YOUR_DB?sslmode=require

# Any long random string. Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Vercel Blob storage token (Vercel dashboard > Storage > Blob > create a store,
# then it appears here automatically once the project is linked - or copy it
# from Storage > your blob store > .env.local tab)
BLOB_READ_WRITE_TOKEN=

# Comma-separated list of frontend origins allowed to call this API
CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

PORT=4000
